---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  light?: boolean;
  class?: string;
}
const { eyebrow, title, align = 'left', light = false, class: cls = '' } = Astro.props;
const isCenter = align === 'center';
---

<div class:list={[isCenter ? 'text-center' : 'text-left', cls]}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <div class:list={['flex items-center gap-4', isCenter && 'justify-center']}>
    {!isCenter && <span class="rule-gold"></span>}
    <h2
      class:list={[
        'font-display text-3xl font-semibold leading-tight sm:text-4xl md:text-[2.6rem]',
        light ? 'text-hueso' : 'text-carbon',
      ]}
    >
      {title}
    </h2>
  </div>
  {isCenter && <span class="rule-gold mx-auto mt-4"></span>}
</div>
