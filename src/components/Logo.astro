---
// Logo oficial de Madera Design (monograma M/D + wordmark).
// mode 'mark'  -> monograma + texto (compacto, para el header)
// mode 'full'  -> lockup completo en imagen (para el footer)
// variant 'oro' | 'claro' (color del texto/tono)
import { withBase } from '../lib/url';

interface Props {
  variant?: 'oro' | 'claro';
  mode?: 'mark' | 'full';
  class?: string;
}
const { variant = 'oro', mode = 'mark', class: cls = '' } = Astro.props;

const textColor = variant === 'claro' ? '#FBF7F1' : '#2E211A';
const subColor = variant === 'claro' ? 'rgba(251,247,241,.65)' : 'rgba(46,33,26,.6)';
const monograma = variant === 'claro' ? '/images/logo-monograma-claro.png' : '/images/logo-monograma.png';
---

{
  mode === 'full' ? (
    <img
      src={withBase(variant === 'claro' ? '/images/logo-claro.png' : '/images/logo.png')}
      alt="Madera Design"
      class={`h-auto w-auto ${cls}`}
      width="200"
      height="99"
    />
  ) : (
    <span class={`inline-flex items-center gap-3 ${cls}`} aria-label="Madera Design">
      <img
        src={withBase(monograma)}
        alt=""
        aria-hidden="true"
        class="h-11 w-auto shrink-0"
        width="44"
        height="44"
      />
      <span class="flex flex-col leading-none">
        <span class="font-marca text-lg tracking-[0.16em]" style={`color:${textColor}`}>
          MADERA DESIGN
        </span>
        <span class="font-sans text-[0.6rem] tracking-[0.32em]" style={`color:${subColor}`}>
          MADERA Y ESTILO
        </span>
      </span>
    </span>
  )
}
