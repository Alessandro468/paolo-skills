---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { categorias } from '../../data/categories';
---

<BaseLayout
  title="Catálogo"
  description="Explora el catálogo de Madera Design: muebles, centros de TV, cocinas, closets y vestiers a la medida."
>
  <!-- Encabezado de página -->
  <section class="relative overflow-hidden bg-espresso py-16 text-hueso md:py-20">
    <div class="texture-slats absolute inset-0 opacity-20"></div>
    <div class="container-max relative">
      <p class="eyebrow mb-3">Catálogo</p>
      <h1 class="font-display text-4xl font-semibold sm:text-5xl">Nuestras categorías</h1>
      <p class="mt-4 max-w-xl text-crema/75">
        Cada categoría es un punto de partida. Todos nuestros productos se fabrican
        a la medida de tu espacio y tu estilo.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-max grid gap-8 md:grid-cols-2">
      {
        categorias.map((c, i) => (
          <div class="grid gap-6 sm:grid-cols-[1fr_1.1fr] sm:items-stretch">
            <CategoryCard categoria={c} index={i} />
            <div class="flex flex-col justify-center">
              <span class="font-marca text-sm text-oro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="mt-1 font-display text-2xl font-semibold text-carbon">{c.nombre}</h2>
              <p class="mt-3 text-sm leading-relaxed text-carbon/70">{c.detalle}</p>
              <a
                href={`/catalogo/${c.slug}`}
                class="link-underline mt-4 inline-flex w-fit items-center gap-2 text-sm font-medium text-cacao"
              >
                Ver {c.nombre.toLowerCase()} →
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
