---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { categorias } from '../data/categories';
import { productosDestacados } from '../data/catalog';
import { whatsappLink } from '../data/site';
import { withBase } from '../lib/url';

const destacados = productosDestacados(4);

const valores = [
  {
    titulo: 'Diseño exclusivo',
    texto:
      'Cada pieza se proyecta a la medida de tu espacio y tu estilo de vida. Nada de soluciones genéricas.',
    icon: 'M12 3 3 8v8l9 5 9-5V8l-9-5Zm0 2.3 6.5 3.6L12 12.5 5.5 8.9 12 5.3Z',
  },
  {
    titulo: 'Materiales importados',
    texto:
      'Trabajamos con maderas, herrajes y acabados importados que aseguran durabilidad y una estética superior.',
    icon: 'M4 7h16v10H4V7Zm2 2v6h12V9H6Z',
  },
  {
    titulo: 'Fabricación propia',
    texto:
      'Controlamos todo el proceso, del boceto a la instalación, para cuidar cada detalle del resultado final.',
    icon: 'M3 21v-4l11-11 4 4L7 21H3ZM14 4l3-3 4 4-3 3-4-4Z',
  },
];

const proceso = [
  { paso: 'Asesoría', texto: 'Escuchamos tu idea, medimos el espacio y entendemos cómo vives.' },
  { paso: 'Diseño', texto: 'Proyectamos la pieza a la medida con materiales y acabados a elegir.' },
  { paso: 'Fabricación', texto: 'Elaboramos tu mueble en taller con control de cada detalle.' },
  { paso: 'Instalación', texto: 'Instalamos con precisión y dejamos tu espacio listo para disfrutar.' },
];
---

<BaseLayout>
  <Hero />

  <!-- Categorías -->
  <section class="py-20 md:py-28">
    <div class="container-max">
      <SectionHeading
        eyebrow="Qué fabricamos"
        title="Nuestras especialidades"
        align="center"
      />
      <p class="mx-auto mt-5 max-w-xl text-center text-carbon/70">
        Del área social a la más íntima: mobiliario que ordena, embellece y perdura.
      </p>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {categorias.map((c, i) => <CategoryCard categoria={c} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Propuesta de valor -->
  <section class="relative overflow-hidden bg-crema py-20 md:py-28">
    <div class="container-max grid gap-14 md:grid-cols-[0.9fr_1.1fr] md:items-center">
      <div>
        <SectionHeading eyebrow="Por qué Madera Design" title="Piezas con la personalidad de quien las habita" />
        <p class="mt-6 max-w-md leading-relaxed text-carbon/75">
          Creemos que un mueble no solo ocupa un espacio: lo define. Por eso cada
          proyecto combina diseño exclusivo, materiales importados y una fabricación
          cuidada de principio a fin.
        </p>
        <a
          href={whatsappLink('Hola Madera Design, me gustaría conversar sobre un proyecto a la medida.')}
          target="_blank"
          rel="noopener"
          class="btn-dark mt-8"
        >
          Conversemos tu proyecto
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-3">
        {
          valores.map((v) => (
            <div class="rounded-sm border border-carbon/10 bg-hueso p-6 shadow-soft">
              <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-espresso">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#C9A96A" aria-hidden="true">
                  <path d={v.icon} />
                </svg>
              </div>
              <h3 class="font-display text-xl font-semibold text-carbon">{v.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-carbon/70">{v.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="relative overflow-hidden bg-espresso py-20 text-hueso md:py-28">
    <div class="texture-slats absolute inset-0 opacity-20"></div>
    <div class="container-max relative">
      <SectionHeading eyebrow="Cómo trabajamos" title="Un proceso a la medida" light align="center" />
      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          proceso.map((p, i) => (
            <div class="relative">
              <span class="font-display text-5xl font-semibold text-oro/40">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-2xl font-semibold text-oro-claro">{p.paso}</h3>
              <p class="mt-2 text-sm leading-relaxed text-crema/70">{p.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Destacados -->
  <section class="py-20 md:py-28">
    <div class="container-max">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Selección" title="Proyectos destacados" />
        <a href={withBase('/catalogo')} class="link-underline text-sm font-medium text-cacao">
          Ver todo el catálogo →
        </a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {destacados.map((p) => <ProductCard producto={p} />)}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="container-max pb-4">
    <div
      class="relative overflow-hidden rounded-sm bg-chocolate px-8 py-16 text-center text-hueso shadow-card md:py-20"
    >
      <div class="texture-slats absolute inset-0 opacity-20"></div>
      <div class="relative mx-auto max-w-2xl">
        <p class="eyebrow mb-4">¿Listo para empezar?</p>
        <h2 class="font-display text-3xl font-semibold sm:text-4xl md:text-5xl">
          Diseñemos juntos el mueble que tu espacio merece
        </h2>
        <p class="mt-5 text-crema/80">
          Cuéntanos tu idea por WhatsApp y recibe asesoría sin compromiso.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href={whatsappLink('Hola Madera Design, quisiera una cotización a la medida.')}
            target="_blank"
            rel="noopener"
            class="btn-primary"
          >
            Cotizar por WhatsApp
          </a>
          <a href={withBase('/contacto')} class="btn-outline text-hueso">Ir a contacto</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
